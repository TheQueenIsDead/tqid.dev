        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "expr": "resticprofile_check_success",
          "legendFormat": "Check",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "(time() - node_textfile_mtime_seconds{file=~\".*maintenance.prom\"})",
          "legendFormat": "Age",
          "instant": true,
          "refId": "B",
