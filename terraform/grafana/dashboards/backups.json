{
  "uid": "tqid-backups",
  "title": "Backups",
  "description": "restic backups to Backblaze B2, from the metrics resticprofile writes after each run (etc/resticprofile.yaml).",
  "tags": [
    "tqid"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "30m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TQID",
      "type": "dashboards",
      "tags": [
        "tqid"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latest run",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Result",
      "description": "0 failed, 1 completed with warnings (e.g. a file was unreadable), 2 OK.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "expr": "resticprofile_backup_status",
          "legendFormat": "{{profile}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failed",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Warnings",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "OK",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
