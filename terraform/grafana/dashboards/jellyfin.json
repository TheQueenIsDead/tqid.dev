    {
      "id": 7,
      "type": "stat",
      "title": "Failed logins",
      "description": "Wrong passwords. Traffic > Failed logins has the source IPs; the Repeated failed logins alert fires on bursts.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
