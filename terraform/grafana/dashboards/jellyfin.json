        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "{job=\"jellyfin/webhook\", event=\"PlaybackStop\"} | json | line_format `{{ .user }}  {{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}  ({{ .device }}{{ if eq .completed \"True\" }}, finished{{ else }}, stopped at {{ .position }}{{ end }})`",
