        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (title) (count_over_time({job=\"jellyfin/webhook\", event=\"PlaybackStart\"} | json | label_format title=`{{ if .series }}{{ .series }}{{ else }}{{ .name }}{{ end }}` [$__range])))",
          "legendFormat": "{{title}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
