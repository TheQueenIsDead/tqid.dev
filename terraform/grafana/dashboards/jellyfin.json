{
  "uid": "tqid-jellyfin",
  "title": "Jellyfin",
  "description": "Who watched what, logins and new items, from Jellyfin's Webhook plugin (etc/alloy/jellyfin.alloy, docs/JELLYFIN.md).",
  "tags": [
    "tqid"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TQID",
      "type": "dashboards",
      "tags": [
        "tqid"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Now playing",
      "description": "What each Jellyfin session is playing right now, from the Webhook plugin's progress events. Empty when nothing is playing.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "max by (user, client, device, title) (max_over_time({job=\"jellyfin/webhook\", event=\"PlaybackProgress\"} | json user, client, device, series, season, episode, name, position_ticks | label_format title=`{{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}` | unwrap position_ticks | __error__=\"\" [1m])) / max by (user, client, device, title) (max_over_time({job=\"jellyfin/webhook\", event=\"PlaybackProgress\"} | json user, client, device, series, season, episode, name, runtime_ticks | label_format title=`{{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}` | unwrap runtime_ticks | __error__=\"\" [1m]))",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        },
        {
          "expr": "max by (user, client, device, title) (last_over_time({job=\"jellyfin/webhook\", event=\"PlaybackProgress\"} | json user, client, device, series, season, episode, name, paused | label_format title=`{{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}` | label_format p=`{{ if eq .paused \"True\" }}1{{ else }}0{{ end }}` | drop paused | unwrap p | __error__=\"\" [1m]))",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        },
        {
          "expr": "(max by (user, client, device, title) (max_over_time({job=\"jellyfin/webhook\", event=\"PlaybackProgress\"} | json user, client, device, series, season, episode, name, runtime_ticks | label_format title=`{{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}` | unwrap runtime_ticks | __error__=\"\" [1m])) - max by (user, client, device, title) (max_over_time({job=\"jellyfin/webhook\", event=\"PlaybackProgress\"} | json user, client, device, series, season, episode, name, position_ticks | label_format title=`{{ if .series }}{{ .series }} S{{ .season }}E{{ .episode }} \u00b7 {{ end }}{{ .name }}` | unwrap position_ticks | __error__=\"\" [1m]))) / 1e7",
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Playing",
                        "color": "green"
                      },
                      "1": {
                        "text": "Paused",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user": "User",
              "title": "Watching",
              "client": "App",
              "device": "Device",
              "Value #A": "Progress",
              "Value #B": "State",
              "Value #C": "Left"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Plays",
      "description": "Playbacks started in the time range.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"jellyfin/webhook\", event=\"PlaybackStart\"} [$__range])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
