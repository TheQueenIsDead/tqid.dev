{
  "uid": "tqid-free-tier",
  "title": "Free tier",
  "description": "Grafana Cloud usage against the free tier (10k series, 50GB logs, 100k synthetic executions), and what is using it.",
  "tags": [
    "tqid"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TQID",
      "type": "dashboards",
      "tags": [
        "tqid"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "This month",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Metrics series",
      "description": "Billable series this month. Faster scrapes count as more series (1 DPM per series is included).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum(grafanacloud_org_metrics_billable_series) / sum(grafanacloud_org_metrics_included_series)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Logs",
      "description": "GB ingested so far this month.",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum(grafanacloud_org_logs_usage) / sum(grafanacloud_org_logs_included_usage)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Logs by month end",
      "description": "Forecast at the last 6h's rate, same as the Logs quota forecast alert.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "(\n  sum(grafanacloud_org_logs_usage)\n  +\n  sum(avg_over_time(grafanacloud_logs_instance_billable_bytes_received_per_second[6h]))\n  * ((days_in_month() - day_of_month() + 1) * 86400 - time() % 86400) / 1e9\n)\n/ sum(grafanacloud_org_logs_included_usage)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Synthetic checks",
      "description": "synthetics.tf spreads the budget evenly over the month, so this should track the day of the month.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum(grafanacloud_org_sm_billable_check_executions) / sum(grafanacloud_org_sm_included_check_executions)",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active series",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum(grafanacloud_instance_active_series)",
          "legendFormat": "active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        },
        {
          "expr": "sum(grafanacloud_org_metrics_included_series)",
          "legendFormat": "free tier",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "free tier"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Log ingestion",
      "description": "The current ingestion rate expressed per month.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum(grafanacloud_logs_instance_billable_bytes_received_per_second) * 86400 * 30",
          "legendFormat": "monthly rate",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        },
        {
          "expr": "sum(grafanacloud_org_logs_included_usage) * 1e9",
          "legendFormat": "free tier",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "decbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "free tier"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Discarded",
      "description": "Anything above zero is telemetry Grafana Cloud rejected; should be empty.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-usage"
      },
      "targets": [
        {
          "expr": "sum by (reason) (grafanacloud_instance_samples_discarded_per_second)",
          "legendFormat": "metrics {{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        },
        {
          "expr": "sum by (reason) (grafanacloud_logs_instance_discarded_bytes_per_second)",
          "legendFormat": "logs {{reason}} (bytes)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-usage"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "What's using it",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Series by job",
      "description": "Active series per scrape job. Extend the allowlists in etc/alloy with this in mind.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "expr": "sort_desc(count by (job) ({__name__=~\".+\"}))",
          "legendFormat": "{{job}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top metrics",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "expr": "topk(15, count by (__name__) ({__name__=~\".+\"}))",
          "legendFormat": "{{__name__}}",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Logs by source (per month)",
      "description": "Each source's average rate over the time range, projected to a month. Host journal logs have no container.",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (container, job) (bytes_rate({job=~\".+\"} [$__range]))) * 86400 * 30",
          "legendFormat": "{{container}} {{job}}",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "decbytes",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      }
    }
  ]
}
