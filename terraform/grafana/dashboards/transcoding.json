    {
      "id": 6,
      "type": "stat",
      "title": "Software encodes",
      "description": "Encodes that ran on the CPU. Each one pegs every core for an hour or more; the Software transcode alert fires on them.",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"tdarr/job-reports\", type=\"transcode\"} |= \"tdarr-ffmpeg -y\" | regexp \"-c:0 (?P<encoder>[a-z0-9_]+)\" | encoder=~\"libx265|libx264|libsvtav1|libaom-av1\" [$__range])) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
