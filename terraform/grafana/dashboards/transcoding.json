{
  "uid": "tqid-transcoding",
  "title": "Transcoding",
  "description": "Tdarr's job history and what it costs the NUC. Jobs come from the filtered job reports in Loki (etc/alloy/tdarr.alloy), library counts from tdarr-exporter, the iGPU from drm-exporter.",
  "tags": [
    "tqid"
  ],
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "TQID",
      "type": "dashboards",
      "tags": [
        "tqid"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Workers",
      "description": "What each busy Tdarr worker is doing right now. Empty when Tdarr is idle.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "targets": [
        {
          "expr": "max by (worker_id, worker_type, file) (label_replace(tdarr_node_worker_info, \"file\", \"$1\", \"worker_file\", \".*/([^/]+)$\")) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "max by (worker_id) (tdarr_node_worker_ratio) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "max by (worker_id) (tdarr_node_worker_fps) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "max by (worker_id) (time() - tdarr_node_worker_job_start_timestamp_seconds / 1000) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "max by (worker_id) (tdarr_node_worker_eta_seconds) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        },
        {
          "expr": "max by (worker_id) (tdarr_node_worker_est_file_size_bytes / tdarr_node_worker_original_file_size_bytes) and on (worker_id) (max by (worker_id) (tdarr_node_worker_idle) == 0)",
          "instant": true,
          "format": "table",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Progress"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FPS"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Elapsed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ETA"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Est. size"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 1.1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "worker_id": true,
              "Value #A": true
            },
            "renameByName": {
              "worker_type": "Worker",
              "file": "File",
              "Value #B": "Progress",
              "Value #C": "FPS",
              "Value #D": "Elapsed",
              "Value #E": "ETA",
              "Value #F": "Est. size"
            }
          }
        }
      ]
    },
    {
