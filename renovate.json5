{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:disableRateLimiting",
  ],
  // https://docs.renovatebot.com/configuration-options
  "minimumReleaseAge": "7 days",

  // https://docs.renovatebot.com/modules/manager/
  "docker-compose": {
    // https://docs.renovatebot.com/modules/manager/#extending-a-managers-default-managerfilepatterns
    "managerFilePatterns": [
      // Keep the manager's defaults (docker-compose.yml etc.)
      "$default",
      // All compose files in the docker folder
      "/^docker/[^/]+\\.ya?ml$/"
    ]
  },


  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]

}
