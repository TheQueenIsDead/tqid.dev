{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  "minimumReleaseAge": "7 days",

  // https://docs.renovatebot.com/modules/manager/
  "docker-compose": {
    // https://docs.renovatebot.com/modules/manager/#extending-a-managers-default-managerfilepatterns
    "managerFilePatterns": [
      // All files in the docker folder
      "/^\/docker\/[a-z]+\.yml$/"
    ]
  }
}
