{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    // https://docs.renovatebot.com/presets-default/#disableratelimiting
    ":disableRateLimiting",
  ],
  // https://docs.renovatebot.com/configuration-options
  "minimumReleaseAge": "7 days",

  // https://docs.renovatebot.com/modules/manager/
  "docker-compose": {
    // https://docs.renovatebot.com/modules/manager/#extending-a-managers-default-managerfilepatterns
    "managerFilePatterns": [
      // Keep the manager's defaults (docker-compose.yml etc.)
      "$default",
      // All compose files in the docker folder
      "/^docker/[^/]+\\.ya?ml$/"
    ]
  },


  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": false // TODO: Enable when confident
    },
    // Ignore versions 14 and 20, as these are remnants of whe the tag was attributed to the Ubuntu version
    // https://github.com/linuxserver/docker-qbittorrent/issues/448#issuecomment-4979556016
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "!/^(14|20)\\./"
    }
  ]
}
