// Shared settings and Grafana Cloud sinks.
//
// Alloy loads every *.alloy file in this directory as a single config, so
// components defined here can be referenced from the other files.
//
// Free tier budget: 10k active series, 50GB logs. Every metrics source scrapes
// at 60s (1 DPM per series) and keeps only an allowlist of golden-signal metrics.

logging {
  level  = "info"
  format = "logfmt"
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_LOKI_USERNAME")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROMETHEUS_USERNAME")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
