// Host metrics (CPU, memory, disk, network, pressure) -> Prometheus
// ~250 series on a typical 8-16 core host.

prometheus.exporter.unix "host" {
	procfs_path    = "/host/proc"
	sysfs_path     = "/host/sys"
	rootfs_path    = "/host/root"
	set_collectors = ["cpu", "diskstats", "filesystem", "hwmon", "loadavg", "meminfo", "netdev", "pressure", "stat", "textfile", "uname"]

	filesystem {
		mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tmpfs|tracefs)$"
	}

	netdev {
		device_exclude = "^(veth.*|br-.*|docker\\d+|lo)$"
	}

	// resticprofile writes each backup's result here (see etc/resticprofile.yaml).
	textfile {
		directory = "/host/root/var/lib/resticprofile/metrics"
	}
}

discovery.relabel "host" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "instance"
		replacement  = constants.hostname
	}

	rule {
		target_label = "job"
		replacement  = "integrations/node_exporter"
	}
}

prometheus.scrape "host" {
	targets         = discovery.relabel.host.output
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.host.receiver]
}

prometheus.relabel "host" {
	rule {
		source_labels = ["__name__"]
		action        = "keep"
		regex         = string.join([
			"up",
			// Utilisation
			"node_cpu_seconds_total",
			"node_load(1|5|15)",
			"node_memory_(MemTotal|MemAvailable|SwapTotal|SwapFree)_bytes",
			"node_filesystem_(avail|size)_bytes",
			"node_filesystem_readonly",
			"node_disk_(read|written)_bytes_total",
			"node_disk_io_time_seconds_total",
			"node_network_(receive|transmit)_bytes_total",
			// Saturation
			"node_pressure_(cpu|memory|io)_waiting_seconds_total",
			// Errors
			"node_network_(receive|transmit)_(errs|drop)_total",
			// Backups (textfile collector, written by resticprofile)
			"node_textfile_mtime_seconds",
			"node_textfile_scrape_error",
			"resticprofile_backup_(status|time_seconds|duration_seconds|added_bytes)",
			"resticprofile_check_success",
			// Temperatures (hwmon): CPU package/cores, NVMe, board sensors
			"node_hwmon_temp_celsius",
			"node_hwmon_temp_crit_celsius",
			"node_hwmon_sensor_label",
			// Info
			"node_boot_time_seconds",
			"node_uname_info",
		], "|")
	}

	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
