// Per-container metrics (cAdvisor) -> Prometheus
// ~17 series per container. Metric and label names match what the Grafana Cloud Docker
// integration dashboards query (they filter on `name`), so those work as-is.

prometheus.exporter.cadvisor "containers" {
	docker_host                  = "unix:///var/run/docker.sock"
	docker_only                  = true
	store_container_labels       = false
	allowlisted_container_labels = ["com.docker.compose.project", "com.docker.compose.service"]
	enabled_metrics              = ["cpu", "memory", "network", "diskIO"]
}

prometheus.scrape "cadvisor" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	job_name        = "integrations/cadvisor"
	scrape_interval = "60s"
	forward_to      = [prometheus.relabel.cadvisor.receiver]
}

prometheus.relabel "cadvisor" {
	rule {
		source_labels = ["__name__"]
		action        = "keep"
		regex         = string.join([
			// Utilisation
			"container_cpu_usage_seconds_total",
			"container_memory_working_set_bytes",
			"container_memory_usage_bytes",
			"container_network_(receive|transmit)_bytes_total",
			"container_fs_(reads|writes)_bytes_total",
			"container_fs_(reads|writes)_total",
			// Saturation
			"container_cpu_cfs_throttled_seconds_total",
			"container_spec_memory_limit_bytes",
			"container_spec_memory_reservation_limit_bytes",
			"machine_memory_bytes",
			// Errors
			"container_network_(receive|transmit)_errors_total",
			"container_network_(receive|transmit)_packets_dropped_total",
			"machine_scrape_error",
			// Inventory and restarts
			"container_last_seen",
			"container_start_time_seconds",
		], "|")
	}

	// Drop the root and non-container cgroups. Host-level machine_* metrics have no name.
	rule {
		source_labels = ["__name__", "name"]
		action        = "drop"
		regex         = "container_.+;"
	}

	rule {
		source_labels = ["name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	// Raw cgroup path and the original Docker labels, now copied to the labels above.
	// `name` and `image` are kept for the integration dashboards.
	rule {
		action = "labeldrop"
		regex  = "id|container_label_.+"
	}

	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}
